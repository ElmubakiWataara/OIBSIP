# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/pizzaflow
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Email (Mailtrap sandbox while developing)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=PizzaFlow <no-reply@example.com>

# Razorpay test mode only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Business settings
DEFAULT_CURRENCY=INR
LOW_STOCK_CRON_SCHEDULE=0 */6 * * *
ADMIN_ALERT_EMAIL=
ADMIN_NAME=PizzaFlow Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
